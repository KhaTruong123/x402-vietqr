# npm run setup:testnet creates .env with fresh testnet wallets. This file is only a reference.
# Never put mainnet keys here.

PORT=3010
PUBLIC_URL=http://localhost:3010
FACILITATOR_URL=https://x402.org/facilitator

# Wallets that receive the agent's USDC (x402 payTo)
STELLAR_PAY_TO=G...
STELLAR_PAY_TO_SECRET=S...        # only for recovering test funds, the server does not use it
BASE_PAY_TO=0x...                 # leave empty to accept Stellar only
BASE_PAY_TO_PRIVATE_KEY=0x...     # only for recovering test funds, the server does not use it

# Limits
MAX_ORDER_USD=50
QUOTE_TTL_SECONDS=300

# Mock pricing (GAIAN_MODE=mock only). Demo numbers, not a real rate or fee.
MOCK_VND_PER_USDC=26300
MOCK_FEE_RATE=0

# Agent wallet (used by the MCP server and scripts/demo.ts)
AGENT_API_URL=http://localhost:3010
AGENT_STELLAR_SECRET=S...
AGENT_EVM_PRIVATE_KEY=            # Base Sepolia wallet holding test USDC, fund it at faucet.circle.com

# Gaian. mock = demo pricing, no VND moves. sandbox = calls the Gaian sandbox API.
GAIAN_MODE=mock
GAIAN_HOST=https://sandbox.gaian.network
GAIAN_KEY=
GAIAN_SECRET=
GAIAN_TREASURY_USER_ID=           # a sandbox user that has passed KYC
GAIAN_TREASURY_WALLET=            # that user's Stellar wallet
GAIAN_TREASURY_SECRET=            # signs the USDC funding transaction to Gaian
GAIAN_CHAIN_ID=148
